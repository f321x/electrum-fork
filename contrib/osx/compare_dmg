#!/usr/bin/env bash
#
# Checks that a release DMG contains the same app as your own unsigned build, apart from the
# release manager's code signatures and notarization ticket. Compare one DMG per architecture:
#
#   ./contrib/osx/compare_dmg dist/electrum-$VERSION-arm64-unsigned.dmg electrum-$VERSION-arm64.dmg
#
# It checks that both DMGs have one volume with the same top-level items (just Electrum.app),
# copies the release app's signatures onto a copy of your app, and then compares every file,
# directory and symlink of the two apps (codesign_replay.py manifest).
# The DMG files themselves are not compared, as hdiutil's output is not reproducible.

set -e

if [ $(uname) != "Darwin" ]; then
    echo "This script needs to be run on macOS."
    exit 1
fi
if [ $# -ne 2 ]; then
    echo "usage: $0 <unsigned dmg> <release dmg>"
    exit 1
fi

CONTRIB_OSX="$(dirname "$(realpath "$0")")"
UNSIGNED_DMG="$1"
RELEASE_DMG="$2"
WORKSPACE="/tmp/electrum_compare_dmg"
REPLAY="$CONTRIB_OSX/codesign_replay.py"
PYTHON=/Library/Frameworks/Python.framework/Versions/3.12/bin/python3.12  # installed by make_osx.sh

rm -rf "$WORKSPACE"
mkdir -p "$WORKSPACE"

# Copies Electrum.app out of DMG $1 to directory $2, and lists the DMG's volume name and top-level
# items in $2.toplevel. The DMG must have exactly one volume: users get all of them.
# ditto keeps the symlinks inside the app as symlinks (cp -r follows them), but follows a symlink
# given as its argument, so Electrum.app itself must be a directory.
copy_app() {
    local root="$2.mnt" vol app
    mkdir -p "$root" "$2"
    hdiutil attach -readonly -nobrowse -mountroot "$root" "$1" > /dev/null
    vol="$(ls -A "$root")"
    app="$root/$vol/Electrum.app"
    if [ "$(ls -A "$root" | wc -l)" -eq 1 ] && [ -d "$app" ] && [ ! -L "$app" ] && ditto "$app" "$2/Electrum.app"; then
        { echo "$vol"; ls -A "$root/$vol"; } > "$2.toplevel"
        hdiutil detach "$root/$vol" > /dev/null
    else
        echo "Could not copy Electrum.app out of $1, which must have one volume with an Electrum.app directory."
        find "$root" -mindepth 1 -maxdepth 1 -exec hdiutil detach {} \; > /dev/null 2>&1 || true
        return 1
    fi
}

copy_app "$UNSIGNED_DMG" "$WORKSPACE/unsigned"
copy_app "$RELEASE_DMG" "$WORKSPACE/release"
if ! diff "$WORKSPACE/unsigned.toplevel" "$WORKSPACE/release.toplevel"; then
    echo "The DMGs do not hold the same items. Lines starting with < are your DMG, > the release."
    echo "failure"
    exit 1
fi

echo "Copying the release app's signatures onto your app..."
"$PYTHON" "$REPLAY" extract "$WORKSPACE/release/Electrum.app" "$WORKSPACE/sigs"
"$PYTHON" "$REPLAY" apply "$WORKSPACE/sigs" "$WORKSPACE/unsigned/Electrum.app"

"$PYTHON" "$REPLAY" manifest "$WORKSPACE/unsigned/Electrum.app" > "$WORKSPACE/unsigned.manifest"
"$PYTHON" "$REPLAY" manifest "$WORKSPACE/release/Electrum.app" > "$WORKSPACE/release.manifest"
if diff "$WORKSPACE/unsigned.manifest" "$WORKSPACE/release.manifest"; then
    echo "The apps match: $(wc -l < "$WORKSPACE/release.manifest" | tr -d ' ') entries compared."
    echo "success"
    rm -rf "$WORKSPACE"
    exit 0
else
    echo "The apps do *not* match. Lines starting with < are your build, > the release."
    echo "Both apps are in $WORKSPACE."
    echo "failure"
    exit 1
fi
